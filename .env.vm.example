# Copiar este archivo como .env en la raíz del repositorio en la VM.
# No subir el .env real al repositorio.

# Base de datos
DB_NAME=muniques
DB_USER=muni
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# JWT: usar una cadena larga y aleatoria (mínimo 64 caracteres recomendado).
# Generar con: openssl rand -base64 48
JWT_SECRET_KEY=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_AL_MENOS_64_CARACTERES
JWT_EXPIRATION_MS=1800000

# Correo (opcional para la demo; se usa en recuperación de contraseña)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Origen permitido por CORS. En la VM con Nginx es el mismo origen:
# http://IP_PUBLICA o https://dominio.com
CORS_ALLOWED_ORIGINS=http://IP_PUBLICA_DE_LA_VM

# Puerto HTTP publicado por Docker Compose.
HTTP_PORT=80
