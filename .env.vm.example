# ============================================================
# Variables para docker-compose.yml en la VM de Azure
# Copiar a .env y completar. NO versionar el archivo .env.
# Reemplaza todos los valores CAMBIAR_* y IP_PUBLICA_VM antes de arrancar.
# ============================================================

# PostgreSQL dentro de la red Docker (no se publica al exterior).
DB_NAME=db_analisis_sistemas2
DB_USER=muni
# Generar con: openssl rand -hex 24
DB_PASSWORD=CAMBIAR_ESTA_CLAVE

# Generar con: openssl rand -hex 48
JWT_SECRET_KEY=CAMBIAR_ESTE_SECRETO
JWT_EXPIRATION_MS=1800000

# Gmail SMTP. Usar una contraseña de aplicación, no la del correo.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# IP pública o dominio desde el que se abrirá el frontend.
# Sin barra final. Ejemplo: http://20.1.2.3
CORS_ALLOWED_ORIGINS=http://IP_PUBLICA_VM

# Puerto público del frontend. Por defecto 80.
HTTP_PORT=80

# Las evidencias se guardan en el volumen Docker "evidencias_data".
# En esta VM no se usa Azure Blob Storage.
