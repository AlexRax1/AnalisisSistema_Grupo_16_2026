# Perfil de Spring Boot: en Azure Container Apps usar SPRING_PROFILES_ACTIVE=prod.
# SPRING_PROFILES_ACTIVE=prod

SERVER_PORT=8080

# En Azure: <servidor>.postgres.database.azure.com
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_analisis_sistemas2
DB_USER=postgres
DB_PASSWORD=

JWT_SECRET_KEY=
JWT_EXPIRATION_MS=1800000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Orígenes permitidos por CORS, separados por coma.
# Local: http://localhost:4200
# Azure: https://<nombre-swa>.azurestaticapps.net
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Azure Blob Storage: contenedor público de evidencias.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=evidencias
