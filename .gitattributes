# Normalize all text files to LF
* text=auto eol=lf

# Java
*.java text eol=lf

# Angular / TypeScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Angular templates / styles
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Configuration
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf

# Markdown / text
*.md text eol=lf
*.txt text eol=lf

# Shell scripts
*.sh text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.jar binary
*.war binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
